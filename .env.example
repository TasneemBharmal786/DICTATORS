# ==============================================================================
# CAMPUS PULSE AI - Institutional Deployment Environment Variables
# ==============================================================================
# Note: Campus Pulse AI is fully self-contained. No external database or API keys
# are strictly required to build and run the prototype.
# Configure these variables when binding to enterprise production environments.

# Node Environment
NODE_ENV=production

# Server Port
PORT=3000

# Canonical Institutional Domain
NEXT_PUBLIC_APP_URL=https://pulse.rvce.edu.in

# Optional Enterprise Analytics & Telemetry (Leave blank for local/demo runs)
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional LLM Gateway (Used if upgrading Aditi Mentor to live LLM stream)
# LLM_API_KEY=
# LLM_MODEL_ENDPOINT=

# Optional Institutional PostgreSQL Database (Used if upgrading from localStorage)
# DATABASE_URL=postgresql://user:password@localhost:5432/campuspulse
